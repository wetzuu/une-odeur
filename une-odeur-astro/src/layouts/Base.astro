---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
     <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="stylesheet" href="/styles/global.css" />

        </head>
    <body>
    <header class="navbar">
    <nav class="nav-links">
      <a href="/" class="nav-btn">News</a>
      <a href="https://www.fragrantica.com/notes/" class="nav-btn">Notes</a>
      <a href="/account" class="nav-btn">Login</a>
    </nav>
    <div class="nav-right">
      <div class="search-bar">
        <input type="text" placeholder="Search Perfumes..." />
      </div>
      <a href="/account" style="color:white;">
        <i class="far fa-user-circle"></i>
      </a>
    </div>
    </header>

    <slot />

    <footer style="text-align:center; padding:40px; color:#999; font-size:12px;">
        une 'odeur - Abraham, Lauren | Cinco, Timothy | Serrano, Matthew
    </footer>

    </body>
</html>
