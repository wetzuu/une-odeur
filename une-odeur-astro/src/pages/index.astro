---
import Base from '../layouts/Base.astro';
import fragrances from '../data/fragrances.json';
import FragranceCard from '../components/FragranceCard.astro';
import NewsItem from '../components/NewsItem.astro';
---

<Base title="Home">

    <style>
        .main-container {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 30px;
            padding: 20px 5%;
        }

        .hero-banner {
            grid-column: 1 / -1;
            height: 400px;
            background: #eee;
            display: flex;
            align-items: flex-end;
            padding: 40px;
            cursor: pointer;
            border: 1px solid var(--wf-border);
            text-decoration: none;
            color: inherit;
            background-image: url("../public/hero.jpg");
            background-size: cover;
            background-position: center;
            min-height: 400px;
            border-radius: 10px;
        }

        .fragrance-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 20px;
        }

        .perfume-card {
            background: #fff;
            border: 1px solid var(--wf-bg2);
            padding: 10px;
            text-align: center;
            text-decoration: none;
            color: #333;
            transition: transform 0.2s;
        }

        .perfume-card:hover {
            transform: translateY(-5px);
            border-color: var(--wf-bg1);
        }
        
        .sidebar-news {
            background: #fdfdfd;
            padding: 15px;
            border-left: 1px solid var(--wf-bg2);
        }

        .news-item {
            padding: 10px 0;
            border-bottom: 1px solid var(--wf-bg2);
            font-size: 0.85rem;
        }

        .section-title {
            font-size: 1.2rem;
            border-bottom: 2px solid var(--wf-bg1);
            margin-bottom: 20px;
            padding-bottom: 5px;
            text-transform: uppercase;
        }
  </style>

  <div class="main-container">

    <a href="/" class="hero-banner placeholder-box">
      <div style="background: rgba(56, 56, 56, 0.8); padding: 20px; border-radius: 20px;">
        <h2 style = "color: white; font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif">une' odeur</h2>
        <p style = "color: white; font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-style:italic">[feminine] /ɔdœʀ/</p>
        <p style = "color: white; font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-style:italic">&bull; transitive website</p>
        <p style = "color: white; font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif">a site focused on fragrance discovery and reviews of local and international fragrances.</p>
      </div>
    </a>

<section class="content-area">
      <h3 class="section-title">Famous Fragrances</h3>
      <div class="fragrance-grid">
        {fragrances.map(frag => (
          <FragranceCard
            name={frag.name}
            brand={frag.brand}
            image={frag.image}
            slug={frag.slug}
          />
        ))}
      </div>
    </section>

    <aside class="sidebar-news">
      <h3 class="section-title">Recent Recommendations</h3>
      <NewsItem label="Enzo Scents" text="Well-performing fragrances of decent quality on a budget."/>
      <NewsItem label="Scentsmith" text="Offers great selection of fragrances for some niche fragrances, while boasting great performance."/>
      <NewsItem label="Symmetry Labs" text="Premium-quality dupes with decent longevity."/>
      <NewsItem label="Feralde" text="Extremely well-performing dupe fragrances for its price. Exceptionally curated."/>
    </aside>

  </div>

</Base>