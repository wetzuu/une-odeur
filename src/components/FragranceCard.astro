---
const { name, brand, image, slug } = Astro.props;
---

<a href={`/frags/${slug}`} class="perfume-card">
  <div class="card-img">
    <img src={image} alt={name} />
  </div>
  <strong>{name}</strong>
  <p style="font-size: 12px; color: #777;">{brand}</p>
</a>

<style>
  .perfume-card {
    min-height: 200px;
  }

  .card-img {
    width: 100%;
    height: 190px;
    overflow: hidden;
    padding: 8px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    display: flex;
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .card-img:hover img {
    transform: scale(1.05);
  }

  .perfume-card strong, .perfume-card p {
    display: block;
    text-align: center;
  }
</style>